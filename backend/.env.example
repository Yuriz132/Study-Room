# ============================================================
# Study Room 后端环境变量示例
# 复制本文件为 backend/.env 并填入真实值
# （.env 已被 .gitignore 忽略，绝不会被提交到仓库）
# ============================================================

# ---- 基础服务 ----
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# CORS 来源：生产环境请改为前端实际访问地址，如 https://your-domain.com
# 设为 "*" 表示允许所有来源（会禁用 cookie / Authorization 凭据）
CORS_ORIGIN=*

# 请求限流（按 IP）
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# 日志级别：trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ---- AI 服务（OpenAI 兼容协议）----
# 通用对话 / 图片识词 / AI 文章生成 使用的端点（任意兼容 /v1/chat/completions 的服务均可）
AI_BASE_URL=https://api.agnes-ai.cn/v1
# 鉴权 Key：可用 AGNES_API_KEY 或 STEP_API_KEY（二选一，后端优先取 AGNES_API_KEY）
AGNES_API_KEY=
STEP_API_KEY=
# 模型名（按你接入的服务填写）
AI_CHAT_MODEL=agnes-2.5-flash
AI_VISION_MODEL=agnes-2.5-flash
AI_REASONING_EFFORT=low

# ---- 第二套 AI（Mimo 学习助手代理，用于文章 / 内容生成等）----
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.5

# ---- 极验行为验证（Geetest 4 代，注册/登录人机校验）----
# CAPTCHA_ID 同时用于前端（VITE_GEETEST_CAPTCHA_ID，公开）
# CAPTCHA_KEY 仅后端使用，保密
GEETEST_CAPTCHA_ID=
GEETEST_CAPTCHA_KEY=
